# =========================================================
# Credenciales de la Service Account de Google Cloud
# =========================================================
GOOGLE_SHEETS_CLIENT_EMAIL=nombre-service-account@tu-proyecto.iam.gserviceaccount.com

# Copia el valor completo de "private_key" del JSON descargado,
# entre comillas dobles, con los saltos de línea como \n literal.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...tu_clave...\n-----END PRIVATE KEY-----\n"

# ID del Google Sheet (de la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit)
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# =========================================================
# Panel de administración
# =========================================================
ADMIN_PASSWORD=cambia-esta-clave

# =========================================================
# IMPORTANTE: comparte el Google Sheet con el correo de
# GOOGLE_SHEETS_CLIENT_EMAIL dándole permiso de Editor.
# =========================================================
